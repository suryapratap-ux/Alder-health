---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Notice from '../components/Notice.astro';
import { getClinician, clinicians } from '../data/clinicians';
import { exampleAppointment, examplePatient, fill } from '../data/appointment';
import page from '../content/pages/confirmation.json';

/* Appointment confirmation — Figma 5:23610 (desktop), 5:23668 (tablet), 5:23724 (mobile). */
const clinician = getClinician(exampleAppointment.clinicianSlug) ?? clinicians[0];
const firstName = examplePatient.name.split(' ')[0];

const { seo, intro, notice, summaryLabel, plans } = page;
const names = {
	firstName,
	specialty: clinician.specialty.toLowerCase(),
	clinic: clinician.clinic,
	address: clinician.clinicAddress,
};

const preparationSteps = page.preparation.map((step) => ({
	...step,
	copy: fill(step.copy, names),
}));
---

<Layout title={seo.title} description={seo.description}>
	<section class="success">
		<span class="success-mark" aria-hidden="true">
			<img src="/icons/circle-check.svg" width="20" height="20" alt="" />
		</span>

		<p class="eyebrow">{intro.eyebrow}</p>
		<h1>{intro.title}</h1>
		<p class="lead">{fill(intro.lead, names)}</p>

		<Notice title={notice.title} tone="success">{notice.copy}</Notice>
	</section>

	<section class="details">
		<div class="summary-column">
			<div class="summary">
				<p class="summary-label">
					{summaryLabel} &middot; {exampleAppointment.reference}
				</p>

				<div class="clinician">
					<img
						src={clinician.photo}
						width={clinician.photoWidth}
						height={clinician.photoHeight}
						style={`object-position: ${clinician.photoFocus}`}
						alt={clinician.alt}
					/>
					<div>
						<p class="name">{clinician.name}</p>
						<p>{clinician.specialty}</p>
					</div>
				</div>

				<div class="rule"></div>

				<div class="facts">
					<p class="date">{exampleAppointment.dateShort}</p>
					<p>{exampleAppointment.timeRange}</p>
					<p>{exampleAppointment.format}</p>
					<p>{clinician.clinic}</p>
					<p>{clinician.clinicAddress}</p>
					<p>Patient: {examplePatient.name}</p>
				</div>

				<p class="disclaimer">Fictional clinician and clinic. Example availability only.</p>
			</div>

			<div class="summary-actions">
				<Button href="/dashboard">
					<img src="/icons/calendar-days.svg" width="18" height="18" alt="" />
					Add to calendar
				</Button>
				<Button href="/dashboard" variant="secondary">View appointments</Button>
			</div>

			<p class="static-note">Calendar and account actions are static examples.</p>
		</div>

		<div class="preparation">
			<h2 class="section-title">A little preparation, a calmer day.</h2>

			{
				preparationSteps.map((step) => (
					<div class="preparation-step">
						<h3>{step.index} / {step.title}</h3>
						<p>{step.copy}</p>
					</div>
				))
			}

			<div class="rule"></div>

			<div class="plans">
				<h2 class="section-title">{plans.title}</h2>
				<p>{plans.copy}</p>
				<p class="email">{plans.email}</p>
				<p class="reference">
					{plans.referenceLabel} &middot; Reference {exampleAppointment.reference}
				</p>
			</div>
		</div>
	</section>
</Layout>

<style>
	.success {
		display: flex;
		flex-direction: column;
		gap: var(--space-24);
		align-items: flex-start;
		padding: var(--space-64) var(--layout-gutter) var(--space-40);
	}

	.success-mark {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: var(--status-success-surface);
	}

	h1 {
		font-size: 52px;
	}

	.lead {
		font-size: 18px;
	}

	.success :global(.notice) {
		width: 100%;
	}

	.details {
		display: flex;
		gap: var(--space-56);
		align-items: flex-start;
		padding: 0 var(--layout-gutter) var(--space-64);
	}

	.summary-column {
		display: flex;
		flex-direction: column;
		gap: var(--space-20);
		align-items: flex-start;
		width: 432px;
		flex-shrink: 0;
	}

	.summary {
		display: flex;
		flex-direction: column;
		gap: var(--space-20);
		align-items: flex-start;
		width: 100%;
		padding: var(--space-24);
		border-radius: var(--radius-module);
		background: var(--brand-secondary);
	}

	.summary-label {
		font-size: var(--type-small);
		font-weight: 600;
		text-transform: uppercase;
		color: var(--brand-primary);
	}

	.clinician {
		display: flex;
		gap: 14px;
		align-items: center;
	}

	.clinician img {
		width: 64px;
		height: 72px;
		flex-shrink: 0;
		border-radius: var(--radius-control);
		object-fit: cover;
	}

	.clinician p {
		font-size: var(--type-body);
		line-height: 1.7;
		color: var(--text-primary);
	}

	.name {
		font-weight: 600;
	}

	.facts p {
		font-size: var(--type-body);
		line-height: 2;
		color: var(--text-secondary);
	}

	.date {
		font-weight: 600;
		color: var(--text-primary);
	}

	.disclaimer {
		font-size: var(--type-eyebrow);
		color: var(--text-secondary);
	}

	.summary-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-12);
	}

	.static-note {
		font-size: var(--type-caption);
		color: var(--text-secondary);
	}

	.preparation {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-32);
		align-items: flex-start;
		min-width: 0;
	}

	.preparation-step {
		width: 100%;
	}

	.preparation-step h3 {
		font-size: var(--type-card-heading);
		line-height: 1.18;
	}

	.preparation-step p,
	.plans p {
		margin-top: var(--space-16);
		font-size: var(--type-body);
		line-height: var(--ui-leading);
		color: var(--text-secondary);
	}

	.plans {
		width: 100%;
	}

	.email {
		font-weight: 600;
		color: var(--brand-primary);
	}

	.reference {
		font-size: var(--type-small);
	}

	/* Tablet and mobile — the summary card moves above the preparation steps */
	@media (max-width: 1023px) {
		.details {
			flex-direction: column;
			gap: var(--space-48);
		}

		.summary-column {
			width: 100%;
		}

		.preparation {
			flex: none;
			width: 100%;
		}
	}

	@media (max-width: 767px) {
		.success {
			padding-block: var(--space-40);
		}

		h1 {
			font-size: 40px;
		}

		.lead {
			font-size: var(--type-body);
		}

		.summary-actions {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
		}
	}
</style>
