---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Button from '../components/Button.astro';
import CareBenefits from '../components/home/CareBenefits.astro';
import page from '../content/pages/services.json';
import { home } from '../data/pages';

/*
 * Services — no Figma frame exists for this page. It reuses the page
 * introduction from the inner screens, the numbered service listing from the
 * home page (5:21810) and the care benefits strip.
 *
 * The services themselves come from the home page content so there is one
 * list to edit rather than two that can drift apart.
 */
const { seo, intro, hero, list, formats, next } = page;
const services = home.services.items;
---

<Layout title={seo.title} description={seo.description}>
	<PageIntro
		trail={[{ label: 'Home', href: '/' }, { label: 'Find care', href: '/services' }]}
		current="Services"
		eyebrow={intro.eyebrow}
		title={intro.title}
		lead={intro.lead}
	/>

	<section class="banner">
		<img
			src={hero.image.src}
			width="1376"
			height="768"
			style={`object-position: ${hero.image.focus}`}
			alt={hero.image.alt}
		/>
		<p class="credit">{hero.caption}</p>
	</section>

	<section class="catalogue" id="services">
		<div class="catalogue-intro">
			<p class="eyebrow">{list.eyebrow}</p>
			<h2 class="section-title">{list.heading}</h2>
			<p class="supporting">{list.intro}</p>
		</div>

		<ul class="directory">
			{
				services.map((service) => (
					<li>
						<a class="listing" href="/find-a-doctor">
							<span class="index">{service.index}</span>
							<span class="editorial">
								<span class="title">{service.title}</span>
								<span class="copy">{service.copy}</span>
								<span class="more link-underline">
									{list.linkLabel} <span class="link-arrow" aria-hidden="true">&#8599;</span>
								</span>
							</span>
							<img src="/icons/arrow-up-right.svg" width="20" height="20" alt="" />
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="formats">
		<div class="formats-intro">
			<p class="eyebrow">{formats.eyebrow}</p>
			<h2 class="section-title">{formats.heading}</h2>
			<Button href="/video-consultations" variant="secondary">{formats.ctaLabel}</Button>
		</div>

		<div class="formats-list">
			{
				formats.items.map((item) => (
					<div class="format">
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
					</div>
				))
			}
		</div>
	</section>

	<CareBenefits />

	<section class="next">
		<div class="next-copy">
			<p class="eyebrow">{next.eyebrow}</p>
			<h2 class="section-title">{next.heading}</h2>
			<p>{next.copy}</p>
		</div>
		<div class="next-actions">
			<Button href={next.primaryCta.href}>
				<img src="/icons/arrow-right.svg" width="18" height="18" alt="" />
				{next.primaryCta.label}
			</Button>
			<Button href={next.secondaryCta.href} variant="secondary">{next.secondaryCta.label}</Button>
		</div>
	</section>

</Layout>

<style>
	.banner {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		padding-inline: var(--layout-pad);
	}

	.banner img {
		width: 100%;
		/* 360px cropped a 16:9 photograph to roughly half its height */
		height: 420px;
		object-fit: cover;
		border-radius: var(--radius-module);
	}

	.credit {
		font-size: var(--type-caption);
		color: var(--text-muted);
	}

	.catalogue {
		display: flex;
		flex-direction: column;
		gap: var(--space-32);
		padding: var(--space-72) var(--layout-pad);
	}

	.catalogue-intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		align-items: flex-start;
		max-width: 640px;
	}

	.supporting {
		font-size: var(--type-body);
		line-height: 1.65;
		color: var(--text-secondary);
	}

	.directory {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.directory li {
		border-top: 1px solid var(--border-default);
	}

	.directory li:last-child {
		border-bottom: 1px solid var(--border-default);
	}

	.listing {
		display: flex;
		gap: var(--space-32);
		align-items: flex-start;
		padding-block: var(--space-32);
		text-decoration: none;
		transition: background 0.2s ease;
	}

	.listing:hover {
		background: var(--bg-subtle);
	}

	.index {
		flex: 0 0 56px;
		font-family: var(--font-editorial);
		font-size: var(--type-card-heading);
		color: var(--brand-accent);
	}

	.editorial {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-8);
		min-width: 0;
	}

	.title {
		font-family: var(--font-editorial);
		font-size: 28px;
		line-height: 1.18;
		letter-spacing: var(--editorial-tracking);
		color: var(--text-primary);
	}

	.copy {
		font-size: var(--type-body);
		line-height: 1.65;
		color: var(--text-secondary);
	}

	.more {
		margin-top: var(--space-8);
		font-size: var(--type-small);
		font-weight: 600;
		color: var(--brand-primary);
	}

	.listing > img {
		flex-shrink: 0;
		margin-top: 6px;
	}

	.formats {
		display: flex;
		gap: var(--space-64);
		align-items: flex-start;
		padding: var(--space-64) var(--layout-pad);
		background: var(--bg-soft-sage);
	}

	.formats-intro {
		display: flex;
		flex: 0 0 360px;
		flex-direction: column;
		gap: var(--space-16);
		align-items: flex-start;
	}

	/*
	 * A bordered button on the sage band would hover to the band colour and
	 * dissolve into it, so it wipes to the subtle surface instead — matching
	 * the same override on the About page.
	 */
	.formats-intro :global(.button--secondary)::before {
		background: var(--bg-subtle);
	}

	.formats-list {
		display: flex;
		flex: 1 0 0;
		gap: var(--space-24);
		min-width: 0;
	}

	.format {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-8);
		min-width: 0;
		padding: var(--space-24);
		border-radius: var(--radius-module);
		background: var(--bg-surface);
	}

	.format h3 {
		font-size: var(--type-body);
		font-weight: 600;
		color: var(--text-primary);
	}

	.format p {
		font-size: var(--type-small);
		line-height: 1.65;
		color: var(--text-secondary);
	}

	.next {
		display: flex;
		gap: var(--space-32);
		align-items: center;
		justify-content: space-between;
		padding: var(--space-64) var(--layout-pad);
		background: var(--bg-subtle);
	}

	.next-copy {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		max-width: 520px;
	}

	.next-copy p:not(.eyebrow) {
		font-size: var(--type-body);
		color: var(--text-secondary);
	}

	.next-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-12);
	}


	/* Tablet — the side-by-side bands stack */
	@media (max-width: 1023px) {
		.formats,
		.next {
			flex-direction: column;
			gap: var(--space-24);
			align-items: flex-start;
		}

		.formats-intro,
		.formats-list {
			flex: none;
			width: 100%;
		}

		.banner img {
			height: 280px;
		}
	}

	@media (max-width: 767px) {
		.catalogue {
			padding-block: var(--space-48);
		}

		.formats-list {
			flex-direction: column;
		}

		.listing {
			gap: var(--space-16);
			padding-block: var(--space-24);
		}

		.index {
			flex-basis: 36px;
			font-size: var(--type-body);
		}

		.title {
			font-size: 22px;
		}

		.banner img {
			height: 200px;
		}
	}
</style>
