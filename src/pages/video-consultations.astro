---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Button from '../components/Button.astro';
import Notice from '../components/Notice.astro';
import Accordion from '../components/Accordion.astro';
import page from '../content/pages/video-consultations.json';
import { questions } from '../data/faq';

/*
 * Video consultations — no Figma frame exists for this page. It reuses the
 * page introduction from the inner screens, the numbered listing from the
 * home services section and the FAQ accordion.
 */
const { seo, intro, hero, about, steps, prepare, faq, next, notice } = page;
---

<Layout title={seo.title} description={seo.description}>
	<PageIntro
		trail={[{ label: 'Home', href: '/' }, { label: 'Find care', href: '/services' }]}
		current="Video consultations"
		eyebrow={intro.eyebrow}
		title={intro.title}
		lead={intro.lead}
	/>

	<section class="overview">
		<div class="photograph">
			<img src={hero.image.src} width="1376" height="768" alt={hero.image.alt} />
		</div>

		<div class="introduction">
			<div class="editorial">
				<h2>{about.heading}</h2>
				{about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				<p class="credit">{hero.caption}</p>
			</div>

			<Button href="/find-a-doctor?visit=Video">
				<img src="/icons/arrow-right.svg" width="18" height="18" alt="" />
				{about.ctaLabel}
			</Button>
		</div>
	</section>

	<section class="steps">
		<div class="steps-intro">
			<p class="eyebrow">{steps.eyebrow}</p>
			<h2 class="section-title">{steps.heading}</h2>
		</div>

		<ol class="step-list">
			{
				steps.items.map((step) => (
					<li class="step">
						<span class="index">{step.index}</span>
						<p class="step-title">{step.title}</p>
						<p class="step-copy">{step.copy}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="prepare">
		<div class="prepare-intro">
			<p class="eyebrow">{prepare.eyebrow}</p>
			<h2 class="section-title">{prepare.heading}</h2>
		</div>

		<div class="prepare-list">
			{
				prepare.items.map((item) => (
					<div class="prepare-item">
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="faq">
		<div class="faq-intro">
			<p class="eyebrow">{faq.eyebrow}</p>
			<h2>{faq.heading}</h2>
			<p class="supporting">{faq.supporting}</p>
			<Button href="/help#contact" variant="secondary">{faq.ctaLabel}</Button>
		</div>

		<Accordion items={questions} name="video-faq" />
	</section>

	<section class="next">
		<div class="next-copy">
			<p class="eyebrow">{next.eyebrow}</p>
			<h2 class="section-title">{next.heading}</h2>
			<p>{next.copy}</p>
		</div>
		<div class="next-actions">
			<Button href={next.primaryCta.href}>
				<img src="/icons/arrow-right.svg" width="18" height="18" alt="" />
				{next.primaryCta.label}
			</Button>
			<Button href={next.secondaryCta.href} variant="secondary">{next.secondaryCta.label}</Button>
		</div>
	</section>

	<section class="disclosure">
		<Notice title={notice.title}>{notice.copy}</Notice>
	</section>
</Layout>

<style>
	.overview {
		display: flex;
		gap: var(--space-64);
		align-items: center;
		padding: var(--space-64) var(--layout-gutter);
		background: var(--bg-subtle);
	}

	.photograph {
		flex: 1 0 0;
		min-width: 0;
		height: 430px;
	}

	.photograph img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--radius-module);
	}

	.introduction {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-24);
		align-items: flex-start;
		min-width: 0;
	}

	.editorial h2 {
		font-size: 44px;
		line-height: 1.18;
	}

	.editorial p {
		margin-top: 26px;
		font-size: var(--type-body);
		line-height: 1.65;
		color: var(--text-secondary);
	}

	.editorial .credit {
		margin-top: var(--space-16);
		font-size: var(--type-caption);
		color: var(--text-muted);
	}

	.steps {
		display: flex;
		flex-direction: column;
		gap: var(--space-32);
		padding: var(--space-72) var(--layout-gutter);
	}

	.steps-intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		align-items: flex-start;
	}

	.step-list {
		display: flex;
		gap: var(--space-24);
		align-items: stretch;
		width: 100%;
	}

	.step {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-8);
		min-width: 0;
		padding-top: var(--space-20);
		border-top: 2px solid var(--brand-primary);
	}

	.index {
		font-family: var(--font-editorial);
		font-size: var(--type-card-heading);
		color: var(--brand-accent);
	}

	.step-title {
		font-size: var(--type-body);
		font-weight: 600;
		color: var(--text-primary);
	}

	.step-copy {
		font-size: var(--type-small);
		line-height: 1.65;
		color: var(--text-secondary);
	}

	.prepare {
		display: flex;
		gap: var(--space-64);
		align-items: flex-start;
		padding: var(--space-64) var(--layout-gutter);
		background: var(--bg-soft-sage);
	}

	.prepare-intro {
		display: flex;
		flex: 0 0 360px;
		flex-direction: column;
		gap: var(--space-12);
		align-items: flex-start;
	}

	.prepare-list {
		display: flex;
		flex: 1 0 0;
		gap: var(--space-24);
		min-width: 0;
	}

	.prepare-item {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-8);
		min-width: 0;
		padding: var(--space-24);
		border-radius: var(--radius-module);
		background: var(--bg-surface);
	}

	.prepare-item h3 {
		font-size: var(--type-body);
		font-weight: 600;
		color: var(--text-primary);
	}

	.prepare-item p {
		font-size: var(--type-small);
		line-height: 1.65;
		color: var(--text-secondary);
	}

	.faq {
		display: flex;
		gap: var(--space-80);
		align-items: flex-start;
		padding: var(--space-72) var(--layout-gutter);
	}

	.faq :global(.accordion) {
		flex: 1 0 0;
		min-width: 0;
	}

	.faq-intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-20);
		align-items: flex-start;
		width: 390px;
		flex-shrink: 0;
	}

	.faq-intro h2 {
		font-size: 44px;
	}

	.supporting {
		font-size: var(--type-body);
		color: var(--text-secondary);
	}

	.next {
		display: flex;
		gap: var(--space-32);
		align-items: center;
		justify-content: space-between;
		padding: var(--space-64) var(--layout-gutter);
		background: var(--bg-subtle);
	}

	.next-copy {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		max-width: 520px;
	}

	.next-copy p:not(.eyebrow) {
		font-size: var(--type-body);
		color: var(--text-secondary);
	}

	.next-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-12);
	}

	.disclosure {
		padding: var(--space-48) var(--layout-gutter) var(--space-72);
	}

	/* Tablet — the paired bands stack and the step list wraps to two rows */
	@media (max-width: 1023px) {
		.overview,
		.prepare,
		.faq,
		.next {
			flex-direction: column;
			gap: var(--space-24);
			align-items: flex-start;
		}

		.photograph {
			width: 100%;
			height: 320px;
		}

		.prepare-intro,
		.faq-intro,
		.prepare-list {
			flex: none;
			width: 100%;
		}

		.faq :global(.accordion) {
			width: 100%;
			flex: none;
		}

		.step-list {
			flex-wrap: wrap;
		}

		.step {
			flex: 1 1 calc(50% - var(--space-24));
		}
	}

	@media (max-width: 767px) {
		.steps {
			padding-block: var(--space-48);
		}

		.editorial h2,
		.faq-intro h2 {
			font-size: var(--type-page-title);
		}

		.step-list,
		.prepare-list {
			flex-direction: column;
		}

		.step {
			flex: none;
			width: 100%;
		}

		.photograph {
			height: 240px;
		}
	}
</style>
