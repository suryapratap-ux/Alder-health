---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import Notice from '../components/Notice.astro';
import DoctorCard from '../components/DoctorCard.astro';
import FilterRail from '../components/finder/FilterRail.astro';
import TabletFilterBar from '../components/finder/TabletFilterBar.astro';
import CompactFilters from '../components/finder/CompactFilters.astro';
import { clinicians } from '../data/clinicians';

import { findADoctor as page } from '../data/pages';

/* Find a doctor — Figma 5:22337 (desktop), 5:22470 (tablet), 5:22587 (mobile). */
const { seo, intro, search } = page;
---

<Layout title={seo.title} description={seo.description}>
	<section class="intro">
		<Breadcrumb trail={[{ label: 'Home', href: '/' }, { label: 'Find care', href: '/#services' }]} current="Doctors" />
		<p class="eyebrow">{intro.eyebrow}</p>
		<h1>{intro.title}</h1>
		<p class="lead">{intro.lead}</p>

		<form class="search" action="/find-a-doctor" method="get">
			<div class="field">
				<label class="field-label" for="doctor-query">{search.queryLabel}</label>
				<div class="control-with-icon">
					<img class="icon" src="/icons/search.svg" width="18" height="18" alt="" />
					<input
						class="control"
						id="doctor-query"
						name="q"
						type="search"
						placeholder={search.queryPlaceholder}
						list="specialty-options"
					/>
					<datalist id="specialty-options">
						{search.specialties.map((item) => <option value={item} />)}
					</datalist>
				</div>
			</div>

			<div class="field">
				<label class="field-label" for="doctor-clinic">{search.clinicLabel}</label>
				<select class="control" id="doctor-clinic" name="clinic">
					{search.clinics.map((item) => <option>{item}</option>)}
				</select>
			</div>

			<Button type="submit" class="submit">{search.submitLabel}</Button>
		</form>
	</section>

	<section class="finder">
		<FilterRail />

		<div class="results">
			<TabletFilterBar />
			<CompactFilters />

			<div class="result-count">
				<p class="count">{clinicians.length} example doctors</p>
				<p class="sort">Sort: Next available <span aria-hidden="true">&#8964;</span></p>
			</div>

			<Notice title="Fictional clinician directory">
				All profiles, credentials, clinic details and availability are fictional examples. Portraits
				are illustrative.
			</Notice>

			<ul class="cards">
				{
					clinicians.map((clinician) => (
						<li>
							<DoctorCard clinician={clinician} />
						</li>
					))
				}
			</ul>

			<p class="exhausted">
				You&rsquo;ve seen all {clinicians.length} example doctors. Broaden or change your filters to
				explore the directory pattern.
			</p>

			<div class="rule"></div>

			<div class="support">
				<h2 class="card-title">Not sure who to choose?</h2>
				<p>
					Our example support team can help you understand services and practical visit options,
					without asking for medical details here.
				</p>
				<Button href="/help#contact" variant="secondary">Contact support</Button>
			</div>
		</div>
	</section>
</Layout>

<style>
	.intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-24);
		align-items: flex-start;
		padding: var(--space-32) var(--layout-gutter) var(--space-40);
	}

	h1 {
		font-size: 56px;
	}

	.search {
		display: flex;
		gap: var(--space-16);
		align-items: flex-end;
		width: 100%;
	}

	.finder {
		display: flex;
		gap: var(--space-40);
		align-items: flex-start;
		padding: 0 var(--layout-gutter) var(--space-80);
	}

	.results {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-24);
		min-width: 0;
	}

	.result-count {
		display: flex;
		gap: var(--space-16);
		align-items: flex-start;
		justify-content: space-between;
	}

	.count {
		font-size: var(--type-body);
		font-weight: 600;
	}

	.sort {
		font-size: var(--type-caption);
		color: var(--text-secondary);
		white-space: nowrap;
	}

	.cards {
		display: flex;
		flex-direction: column;
		gap: var(--space-24);
	}

	.exhausted {
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	.support {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
		align-items: flex-start;
	}

	.support p {
		font-size: var(--type-body);
		color: var(--text-secondary);
	}

	/* Tablet and mobile — filters sit above the results */
	@media (max-width: 1023px) {
		.search {
			flex-direction: column;
			align-items: stretch;
		}

		.search :global(.submit) {
			width: 100%;
		}

		.finder {
			gap: 0;
		}

		.results {
			flex: none;
			width: 100%;
		}
	}

	/* Mobile — the page title steps down and the lead drops to body size */
	@media (max-width: 767px) {
		h1 {
			font-size: var(--type-page-title);
		}

		.lead {
			font-size: var(--type-body);
		}
	}
</style>
