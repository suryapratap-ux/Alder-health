---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import Notice from '../components/Notice.astro';
import ProgressSteps from '../components/booking/ProgressSteps.astro';
import BookingContext from '../components/booking/BookingContext.astro';
import { getClinician, clinicians } from '../data/clinicians';
import { exampleAppointment, calendar, timeSlots, bookingSteps, fill } from '../data/appointment';
import page from '../content/pages/booking.json';

/* Appointment booking — Figma 5:22886 (desktop), 5:23036 (tablet), 5:23184 (mobile). */
const clinician = getClinician(exampleAppointment.clinicianSlug) ?? clinicians[0];
const { seo, intro, visitType, visitNote, careNote, calendarKey, confirmation, actions, note } = page;
const names = {
	name: clinician.name,
	specialty: clinician.specialty.toLowerCase(),
	clinic: clinician.clinic,
	address: clinician.clinicAddress,
};
---

<Layout title={seo.title} description={seo.description}>
	<section class="intro">
		<Breadcrumb trail={[{ label: 'Home', href: '/' }, { label: 'Book appointment', href: '/booking' }]} current="Choose a time" />
		<p class="eyebrow">{intro.eyebrow}</p>
		<h1>{intro.title}</h1>
		<p class="lead">{fill(intro.lead, names)}</p>
		<ProgressSteps steps={bookingSteps} />
	</section>

	<section class="workspace">
		<div class="time-selection">
			<div class="selected-care">
				<p class="care-label">{clinician.name} &middot; {clinician.specialty}</p>
				<p class="care-note">{careNote}</p>
			</div>

			<div class="visit-type">
				<p class="question">{visitType.question}</p>
				<div class="segmented" role="radiogroup" aria-label={visitType.question}>
					<label class="choice">
						<input type="radio" name="booking-visit" value="in-person" checked />
						<span>{visitType.inPersonLabel}</span>
					</label>
					<label class="choice">
						<input type="radio" name="booking-visit" value="video" />
						<span>{visitType.videoLabel}</span>
					</label>
				</div>
				<p class="visit-note">{fill(visitNote, names)}</p>
			</div>

			<div class="rule"></div>

			<div class="selector">
				<div class="month">
					<h2 class="card-title" data-month-label>{calendar.monthLabel}</h2>
					<div class="month-nav">
						<button type="button" aria-label="Previous month" data-month-step="-1">&#8249;</button>
						<button type="button" aria-label="Next month" data-month-step="1">&#8250;</button>
					</div>
				</div>

				<table
					class="calendar"
					data-calendar
					data-year={calendar.year}
					data-month={calendar.monthIndex}
					data-selected={calendar.selected}
				>
					<thead>
						<tr>
							{calendar.weekdays.map((day) => <th scope="col">{day}</th>)}
						</tr>
					</thead>
					<tbody>
						{
							Array.from({ length: Math.ceil((calendar.days + calendar.startWeekday) / 7) }).map(
								(_, week) => (
									<tr>
										{Array.from({ length: 7 }).map((__, weekday) => {
											const dayNumber = week * 7 + weekday - calendar.startWeekday + 1;
											const inMonth = dayNumber >= 1 && dayNumber <= calendar.days;
											if (!inMonth) return <td />;
											const isSelected = dayNumber === calendar.selected;
											const isAvailable = calendar.available.includes(dayNumber);
											return (
												<td>
													<button
														type="button"
														class:list={[
															'day',
															isSelected && 'day--selected',
															isAvailable && 'day--available',
														]}
														aria-pressed={isSelected ? 'true' : 'false'}
													>
														{dayNumber}
													</button>
												</td>
											);
										})}
									</tr>
								)
							)
						}
					</tbody>
				</table>

				<p class="calendar-key">{calendarKey}</p>

				<div class="rule"></div>

				<div class="slots">
					<p class="slot-day" data-slot-day>{exampleAppointment.dayLabel}</p>
					<p class="slot-note">
						{exampleAppointment.visitLabel} &middot; {exampleAppointment.timezone}
					</p>
					<div class="slot-list" role="radiogroup" aria-label="Available times">
						{
							timeSlots.map((slot) => (
								<label class:list={['slot', slot.selected && 'slot--selected']}>
									<input type="radio" name="booking-time" value={slot.label} checked={slot.selected} />
									<span>{slot.label}</span>
								</label>
							))
						}
					</div>
				</div>
			</div>

			<Notice title={confirmation.title} tone="success">
				<span data-summary-day>{exampleAppointment.dayLong}</span> {confirmation.joinWord}{' '}
				<span data-summary-time>{exampleAppointment.time}</span>{' '}
				{fill(confirmation.tail, { duration: exampleAppointment.duration })}
			</Notice>

			<div class="step-navigation">
				<Button href={`/doctors/${clinician.slug}`} variant="secondary">{actions.backLabel}</Button>
				<Button href="/review">
					<img src="/icons/arrow-right.svg" width="18" height="18" alt="" />
					{actions.continueLabel}
				</Button>
			</div>

			<p class="workspace-note">{note}</p>
		</div>

		<BookingContext clinician={clinician} />
	</section>
</Layout>

<script>
	const table = document.querySelector<HTMLTableElement>('[data-calendar]');

	if (table) {
		const body = table.querySelector('tbody')!;

		/*
		 * Astro scopes component styles with a data attribute stamped on the
		 * markup it renders. Cells built here have to carry the same one, or
		 * none of the calendar styling applies to them.
		 */
		const scope = [...table.attributes]
			.map((attribute) => attribute.name)
			.find((name) => name.startsWith('data-astro-cid-'));

		const scoped = <T extends HTMLElement>(element: T) => {
			if (scope) element.setAttribute(scope, '');
			return element;
		};
		const monthLabel = document.querySelector<HTMLElement>('[data-month-label]');
		const steps = [...document.querySelectorAll<HTMLButtonElement>('[data-month-step]')];
		const slotDay = document.querySelector<HTMLElement>('[data-slot-day]');
		const summaryDay = document.querySelector<HTMLElement>('[data-summary-day]');
		const summaryTime = document.querySelector<HTMLElement>('[data-summary-time]');

		/* The month on screen. */
		let year = Number(table.dataset.year);
		let month = Number(table.dataset.month);

		/* The day chosen, which keeps its own month so it survives browsing. */
		let pickedYear = year;
		let pickedMonth = month;
		let pickedDay = Number(table.dataset.selected);

		/* The month and day the page opened on, which anchor the example dates. */
		const openYear = year;
		const openMonth = month;
		const openDay = pickedDay;

		/*
		 * Example availability is the four working days after a reference
		 * date — the booked visit in its own month, the month start in any
		 * other. That rule reproduces the dates the design already shows.
		 */
		const availableIn = (y: number, m: number) => {
			const from = y === openYear && m === openMonth ? openDay : 0;
			const days: number[] = [];
			const cursor = new Date(y, m, from + 1);

			while (days.length < 4 && cursor.getMonth() === m) {
				const weekday = cursor.getDay();
				if (weekday !== 0 && weekday !== 6) days.push(cursor.getDate());
				cursor.setDate(cursor.getDate() + 1);
			}

			return days;
		};

		const monthName = (y: number, m: number) =>
			new Date(y, m, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

		const dayName = (y: number, m: number, d: number, withYear: boolean) =>
			new Date(y, m, d).toLocaleDateString('en-US', {
				weekday: 'long',
				month: 'long',
				day: 'numeric',
				...(withYear ? { year: 'numeric' } : {}),
			});

		/* Browsing is held to the year ahead of whichever month comes first. */
		const indexOf = (y: number, m: number) => y * 12 + m;
		const today = new Date();
		const minIndex = Math.min(
			indexOf(openYear, openMonth),
			indexOf(today.getFullYear(), today.getMonth()),
		);
		const maxIndex = minIndex + 12;

		const draw = () => {
			const first = new Date(year, month, 1).getDay();
			const total = new Date(year, month + 1, 0).getDate();
			const available = availableIn(year, month);
			const weeks = Math.ceil((total + first) / 7);

			body.replaceChildren();

			for (let week = 0; week < weeks; week += 1) {
				const row = scoped(document.createElement('tr'));

				for (let weekday = 0; weekday < 7; weekday += 1) {
					const cell = scoped(document.createElement('td'));
					const number = week * 7 + weekday - first + 1;

					if (number >= 1 && number <= total) {
						const isSelected =
							year === pickedYear && month === pickedMonth && number === pickedDay;

						const button = scoped(document.createElement('button'));
						button.type = 'button';
						button.className = 'day';
						if (isSelected) button.classList.add('day--selected');
						if (available.includes(number)) button.classList.add('day--available');
						button.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
						button.textContent = String(number);
						button.addEventListener('click', () => choose(number));
						cell.append(button);
					}

					row.append(cell);
				}

				body.append(row);
			}

			if (monthLabel) monthLabel.textContent = monthName(year, month);

			for (const step of steps) {
				const next = indexOf(year, month) + Number(step.dataset.monthStep);
				step.disabled = next < minIndex || next > maxIndex;
			}
		};

		const choose = (day: number) => {
			pickedYear = year;
			pickedMonth = month;
			pickedDay = day;

			if (slotDay) slotDay.textContent = dayName(year, month, day, false);
			if (summaryDay) summaryDay.textContent = dayName(year, month, day, true);

			draw();
		};

		for (const step of steps) {
			step.addEventListener('click', () => {
				const next = indexOf(year, month) + Number(step.dataset.monthStep);
				if (next < minIndex || next > maxIndex) return;
				year = Math.floor(next / 12);
				month = next % 12;
				draw();
			});
		}

		draw();

		/* The chosen time moves its highlight with it. */
		const slots = [...document.querySelectorAll<HTMLInputElement>('input[name="booking-time"]')];

		for (const slot of slots) {
			slot.addEventListener('change', () => {
				for (const other of slots) {
					other.closest('.slot')?.classList.toggle('slot--selected', other.checked);
				}
				if (summaryTime && slot.checked) summaryTime.textContent = slot.value;
			});
		}
	}
</script>

<style>
	.intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-20);
		align-items: flex-start;
		padding: var(--space-32) var(--layout-pad) var(--space-24);
	}

	h1 {
		font-size: 52px;
	}

	.lead {
		font-size: 18px;
	}

	.workspace {
		display: flex;
		gap: var(--space-48);
		align-items: flex-start;
		padding: 0 var(--layout-pad) var(--space-64);
	}

	.time-selection {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-28);
		align-items: flex-start;
		min-width: 0;
		padding: var(--space-32);
		border: 1px solid var(--border-default);
		border-radius: var(--radius-module);
		background: var(--bg-surface);
	}

	.care-label {
		font-size: var(--type-small);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--brand-primary);
	}

	.care-note {
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	.visit-type {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		width: 100%;
	}

	.question {
		font-size: var(--type-body);
		font-weight: 600;
	}

	.segmented {
		display: flex;
		gap: var(--space-4);
		width: 100%;
		padding: var(--space-4);
		border-radius: var(--radius-control);
		background: var(--bg-subtle);
	}

	.choice {
		flex: 1 0 0;
		min-width: 0;
	}

	.choice input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.choice span {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: var(--space-8);
		border: 1px solid transparent;
		border-radius: 4px;
		font-size: var(--type-small);
		color: var(--brand-primary);
		cursor: pointer;
	}

	.choice input:checked + span {
		border-color: var(--brand-primary);
		background: var(--bg-surface);
		font-weight: 600;
	}

	.choice input:focus-visible + span {
		outline: 2px solid var(--interactive-focus);
		outline-offset: 2px;
	}

	.visit-note {
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	.selector {
		display: flex;
		flex-direction: column;
		gap: var(--space-24);
		width: 100%;
	}

	.month {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.month-nav {
		display: flex;
		gap: var(--space-16);
	}

	.month-nav button {
		width: 32px;
		height: 32px;
		border: 0;
		background: none;
		font-size: 20px;
		color: var(--text-primary);
		cursor: pointer;
	}

	.calendar {
		width: 100%;
		border-collapse: collapse;
		text-align: center;
	}

	.calendar th {
		padding-bottom: var(--space-12);
		font-size: var(--type-small);
		font-weight: 400;
		color: var(--text-secondary);
	}

	.calendar td {
		padding: var(--space-4);
	}

	.day {
		width: 100%;
		min-width: 44px;
		min-height: 44px;
		border: 0;
		border-radius: var(--radius-control);
		background: none;
		font-size: var(--type-body);
		color: var(--text-secondary);
		cursor: pointer;
	}

	.day--available {
		text-decoration: underline;
		color: var(--text-primary);
	}

	.day--selected {
		background: var(--brand-primary);
		color: var(--text-inverse);
		text-decoration: none;
	}

	.calendar-key {
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	.slots {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
	}

	.slot-day {
		font-size: var(--type-body);
		font-weight: 600;
	}

	.slot-note {
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	.slot-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-12);
		margin-top: var(--space-4);
	}

	.slot input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.slot span {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding-inline: var(--space-20);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-control);
		background: var(--bg-surface);
		font-size: var(--type-body);
		font-weight: 600;
		color: var(--brand-primary);
		cursor: pointer;
	}

	.slot input:checked + span {
		border-color: var(--brand-primary);
		background: var(--brand-primary);
		color: var(--text-inverse);
	}

	.slot input:checked + span::before {
		content: '\2713';
		padding-right: var(--space-8);
	}

	.slot input:focus-visible + span {
		outline: 2px solid var(--interactive-focus);
		outline-offset: 2px;
	}

	.step-navigation {
		display: flex;
		gap: var(--space-16);
		align-items: center;
		justify-content: space-between;
		width: 100%;
	}

	.workspace-note {
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	/* Desktop — the booking context sits in a 360px sidebar */
	@media (min-width: 1024px) {
		.workspace :global(.booking-context) {
			width: 360px;
			flex-shrink: 0;
		}
	}

	/* Tablet and mobile — the context card drops below the selector */
	@media (max-width: 1023px) {
		.workspace {
			flex-direction: column;
			gap: var(--space-32);
		}

		.time-selection {
			flex: none;
			width: 100%;
		}
	}

	@media (max-width: 767px) {
		h1 {
			font-size: var(--type-page-title);
		}

		.lead {
			font-size: var(--type-body);
		}

		.time-selection {
			padding: 0;
			border: 0;
			border-radius: 0;
			background: none;
		}

		.day {
			min-width: 36px;
			font-size: var(--type-small);
		}
	}
</style>
