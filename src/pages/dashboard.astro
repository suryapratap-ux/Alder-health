---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Notice from '../components/Notice.astro';
import ResponsiveAccountNav from '../components/account/ResponsiveAccountNav.astro';
import { getClinician, clinicians } from '../data/clinicians';
import { exampleAppointment, examplePatient, fill } from '../data/appointment';
import page from '../content/pages/dashboard.json';

/* Patient dashboard — Figma 5:23777 (desktop), 5:23892 (tablet), 5:23994 (mobile). */
const clinician = getClinician(exampleAppointment.clinicianSlug) ?? clinicians[0];
const firstName = examplePatient.name.split(' ')[0];

const { seo, rail, greeting, upcoming, past, preferences: preferenceCopy, reading, account } =
	page;

const pastAppointments = past.items;
const preferences = preferenceCopy.items;
const readingList = reading.items;
---

<Layout title={seo.title} description={seo.description}>
	<section class="workspace">
		<aside class="account-rail" aria-label="Patient account">
			<p class="eyebrow">{rail.eyebrow}</p>
			<p class="patient-name">{examplePatient.name}</p>
			<p class="patient-note">{rail.note}</p>

			<nav class="account-nav">
				{
					rail.items.map((item, index) => (
						<a
							href={item.href}
							class:list={['nav-item', index === 0 && 'nav-item--current']}
							data-section={item.href.startsWith('#') ? item.href.slice(1) : undefined}
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</aside>

		<ResponsiveAccountNav items={rail.items} caption={`${rail.eyebrow} · ${rail.note}`} />

		<div class="account-main">
			<div class="greeting" id="overview">
				<p class="eyebrow">{greeting.eyebrow}</p>
				<h1>{fill(greeting.title, { firstName })}</h1>
				<p class="lead">{greeting.lead}</p>
				<p class="demo-note">{greeting.note}</p>
			</div>

			<section class="upcoming" id="appointments">
				<div class="upcoming-head">
					<p class="upcoming-title">{upcoming.title}</p>
					<p class="upcoming-status">{upcoming.status}</p>
				</div>

				<div class="clinician">
					<img
						src={clinician.photo}
						width={clinician.photoWidth}
						height={clinician.photoHeight}
						style={`object-position: ${clinician.photoFocus}`}
						alt={clinician.alt}
					/>
					<div>
						<p class="clinician-name">{clinician.name}</p>
						<p class="clinician-specialty">{clinician.specialty}</p>
						<p class="clinician-note">{upcoming.clinicianNote}</p>
					</div>
				</div>

				<div class="rule"></div>

				<h2 class="appointment-date">{exampleAppointment.dayLong}</h2>

				<div class="appointment-facts">
					<p>{exampleAppointment.timeRange}</p>
					<p>{upcoming.format}</p>
					<p>{clinician.clinic} &middot; {clinician.clinicAddress}</p>
					<p>{examplePatient.name} &middot; {upcoming.referencePrefix} {exampleAppointment.reference}</p>
				</div>

				<div class="appointment-actions">
					<Button href="/confirmation">{upcoming.viewLabel}</Button>
					<Button href="/booking" variant="secondary">{upcoming.rescheduleLabel}</Button>
					<a class="cancel link-underline" href="/dashboard">{upcoming.cancelLabel}</a>
				</div>

				<Notice title={upcoming.noticeTitle}>{upcoming.noticeCopy}</Notice>
			</section>

			<section class="past">
				<h2 class="section-title">{past.title}</h2>
				<p class="past-note">{past.note}</p>

				<ul class="past-list">
					{
						pastAppointments.map((entry) => (
							<li>
								<p class="past-date">
									{entry.date} &middot; {entry.status}
								</p>
								<p>{entry.clinician}</p>
								<p>{entry.place}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="account-details" id="account-details">
				<h2 class="section-title">{account.title}</h2>
				<p class="account-note">{account.note}</p>

				<dl class="account-grid">
					<div class="account-item">
						<dt>{account.nameLabel}</dt>
						<dd>{examplePatient.name}</dd>
					</div>
					<div class="account-item">
						<dt>{account.emailLabel}</dt>
						<dd>{examplePatient.email}</dd>
					</div>
					<div class="account-item">
						<dt>{account.phoneLabel}</dt>
						<dd>{examplePatient.phone}</dd>
					</div>
					<div class="account-item">
						<dt>{account.accessLabel}</dt>
						<dd>{examplePatient.accessNeeds}</dd>
					</div>
				</dl>
			</section>

			<div class="bottom">
				<section class="preferences" id="preferences">
					<h2 class="card-title">{preferenceCopy.title}</h2>
					<p class="preferences-note">{preferenceCopy.note}</p>

					<div class="toggles">
						{
							preferences.map((preference) => (
								<div class="toggle-row">
									<label for={preference.id}>{preference.label}</label>
									<span class="toggle">
										<input
											type="checkbox"
											id={preference.id}
											checked={preference.on}
											data-toggle
											data-on={preferenceCopy.onLabel}
											data-off={preferenceCopy.offLabel}
										/>
										<label class="track" for={preference.id} aria-hidden="true" />
										<span class="state" data-state-for={preference.id}>
											{preference.on ? preferenceCopy.onLabel : preferenceCopy.offLabel}
										</span>
									</span>
								</div>
							))
						}
					</div>

					<Button variant="secondary" data-save-preferences>{preferenceCopy.saveLabel}</Button>

					<p class="preferences-status" data-preferences-status role="status" hidden>
						{preferenceCopy.savedMessage}
					</p>
				</section>

				<section class="reading">
					<h2 class="section-title">{reading.title}</h2>

					<ul class="reading-list">
						{
							readingList.map((title) => (
								<li>
									<a href="/resources">
										<span class="reading-title">{title}</span>
										<img src="/icons/arrow-up-right.svg" width="20" height="20" alt="" />
									</a>
									<p>{reading.note}</p>
								</li>
							))
						}
					</ul>

					<p class="reading-help">{reading.help}</p>
				</section>
			</div>
		</div>
	</section>
</Layout>

<script>
	/* The On/Off word beside each switch is rendered once at build time. */
	for (const input of document.querySelectorAll<HTMLInputElement>('[data-toggle]')) {
		const state = document.querySelector<HTMLElement>(`[data-state-for="${input.id}"]`);

		input.addEventListener('change', () => {
			if (state) state.textContent = input.checked ? input.dataset.on! : input.dataset.off!;
		});
	}

	/*
	 * The save control sits outside any form and there is nothing to save to,
	 * so it says that plainly rather than appearing to have stored something.
	 */
	const save = document.querySelector<HTMLButtonElement>('[data-save-preferences]');
	const saveStatus = document.querySelector<HTMLElement>('[data-preferences-status]');

	save?.addEventListener('click', () => {
		if (saveStatus) saveStatus.hidden = false;
	});

	/*
	 * The rail marks whichever section you have scrolled to, so the highlight
	 * follows the page instead of always sitting on the first item.
	 */
	const railLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-section]')];
	const sections = railLinks
		.map((link) => document.getElementById(link.dataset.section!))
		.filter((section): section is HTMLElement => Boolean(section));

	if (railLinks.length && sections.length) {
		let queued = false;

		const mark = () => {
			queued = false;
			/* The last section to have passed under the header wins. */
			let current = sections[0];
			for (const section of sections) {
				if (section.getBoundingClientRect().top <= 140) current = section;
			}

			for (const link of railLinks) {
				const on = link.dataset.section === current.id;
				link.classList.toggle('nav-item--current', on);
				if (on) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			}
		};

		const schedule = () => {
			if (queued) return;
			queued = true;
			window.requestAnimationFrame(mark);
		};

		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		mark();
	}
</script>

<style>
	.workspace {
		display: flex;
		gap: var(--space-48);
		align-items: flex-start;
		padding: var(--space-48) var(--layout-pad) var(--space-64);
	}

	.account-rail {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		width: 208px;
		flex-shrink: 0;
	}

	.patient-name {
		margin-top: var(--space-8);
		font-size: var(--type-body);
		font-weight: 600;
	}

	.patient-note {
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	.account-nav {
		display: flex;
		flex-direction: column;
		margin-top: var(--space-16);
	}

	.nav-item {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--space-12);
		border-radius: var(--radius-control);
		font-size: var(--type-body);
		color: var(--text-secondary);
		text-decoration: none;
	}

	.nav-item--current {
		background: var(--brand-secondary);
		font-weight: 600;
		color: var(--brand-primary);
	}

	.nav-item:hover {
		color: var(--brand-primary);
	}

	.account-main {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-32);
		min-width: 0;
	}

	.greeting {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
		align-items: flex-start;
	}

	h1 {
		font-size: 52px;
	}

	.lead {
		font-size: 18px;
	}

	.demo-note {
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	.upcoming {
		display: flex;
		flex-direction: column;
		gap: var(--space-24);
		align-items: flex-start;
		padding: var(--space-32);
		border: 1px solid var(--border-default);
		border-radius: var(--radius-module);
		background: var(--bg-surface);
	}

	.upcoming-head {
		display: flex;
		gap: var(--space-16);
		align-items: center;
		justify-content: space-between;
		width: 100%;
	}

	.upcoming-title {
		font-size: var(--type-body);
		font-weight: 600;
	}

	.upcoming-status {
		font-size: var(--type-small);
		color: var(--status-success);
	}

	.clinician {
		display: flex;
		gap: var(--space-16);
		align-items: center;
	}

	.clinician img {
		width: 72px;
		height: 86px;
		flex-shrink: 0;
		border-radius: var(--radius-control);
		object-fit: cover;
	}

	.clinician-name {
		font-family: var(--font-editorial);
		font-size: var(--type-card-heading);
		line-height: 1.2;
		letter-spacing: var(--editorial-tracking);
	}

	.clinician-specialty {
		font-size: var(--type-body);
		color: var(--text-secondary);
	}

	.clinician-note {
		font-size: var(--type-small);
		color: var(--text-muted);
	}

	.appointment-date {
		font-size: var(--type-section);
	}

	.appointment-facts p {
		font-size: var(--type-body);
		line-height: 1.75;
		color: var(--text-secondary);
	}

	.appointment-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-12);
		align-items: center;
	}

	.cancel {
		padding-inline: var(--space-8);
		font-size: 15px;
		font-weight: 600;
		color: var(--brand-primary);
	}

	/*
	 * The padding widens the hit area beside the buttons, but the hover rule is
	 * drawn across the whole box, so it is inset to sit under the words only.
	 */
	.cancel::after {
		left: var(--space-8);
		width: calc(100% - var(--space-8) * 2);
	}

	.upcoming :global(.notice) {
		width: 100%;
	}

	.past {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
		align-items: flex-start;
	}

	.past-note {
		font-size: var(--type-body);
		color: var(--text-secondary);
	}

	.past-list {
		display: flex;
		flex-direction: column;
		width: 100%;
		margin-top: var(--space-8);
	}

	.past-list li {
		padding-block: var(--space-24);
		border-top: 1px solid var(--border-default);
	}

	.past-list p {
		font-size: var(--type-body);
		line-height: 1.75;
		color: var(--text-secondary);
	}

	.past-date {
		color: var(--text-primary);
	}

	.bottom {
		display: flex;
		gap: var(--space-32);
		align-items: flex-start;
	}

	.preferences {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
		align-items: flex-start;
		/*
		 * 520px is the width the design draws, but it has to give way rather
		 * than push the reading column off the page on a narrow desktop.
		 */
		flex: 0 1 520px;
		min-width: 0;
		padding: var(--space-24);
		border-radius: var(--radius-module);
		background: var(--brand-secondary);
	}

	/*
	 * A bordered button on the sage band would hover to the band colour and
	 * dissolve into it, so it wipes to the subtle surface instead.
	 */
	.preferences :global(.button--secondary)::before {
		background: var(--bg-subtle);
	}

	.preferences-note {
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	.toggles {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
		width: 100%;
	}

	.toggle-row {
		display: flex;
		gap: var(--space-16);
		align-items: center;
		justify-content: space-between;
		min-height: 52px;
	}

	.toggle-row label {
		font-size: var(--type-body);
		color: var(--text-secondary);
	}

	.toggle {
		display: flex;
		gap: var(--space-12);
		align-items: center;
	}

	.toggle input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.track {
		position: relative;
		display: block;
		width: 48px;
		height: 28px;
		border-radius: 999px;
		background: var(--border-strong);
		cursor: pointer;
		transition: background 0.15s ease;
	}

	.track::after {
		content: '';
		position: absolute;
		top: 4px;
		left: 4px;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: var(--bg-surface);
		transition: transform 0.15s ease;
	}

	.toggle input:checked + .track {
		background: var(--brand-primary);
	}

	.toggle input:checked + .track::after {
		transform: translateX(20px);
	}

	.toggle input:focus-visible + .track {
		outline: 2px solid var(--interactive-focus);
		outline-offset: 2px;
	}

	.state {
		width: 24px;
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	.reading {
		display: flex;
		/*
		 * A real basis rather than 0: with nothing to ask for, this column was
		 * left whatever the preferences card did not take — 41px at 1024 —
		 * and its contents spilled off the page.
		 */
		flex: 1 1 320px;
		flex-direction: column;
		gap: var(--space-20);
		align-items: flex-start;
		min-width: 0;
	}

	.reading-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-20);
		width: 100%;
	}

	.reading-list li {
		padding-top: var(--space-16);
		border-top: 1px solid var(--border-default);
	}

	.reading-list a {
		display: flex;
		gap: var(--space-16);
		align-items: flex-start;
		justify-content: space-between;
		text-decoration: none;
	}

	.reading-title {
		font-size: var(--type-body);
		font-weight: 600;
		color: var(--text-primary);
	}

	.reading-list a:hover .reading-title {
		color: var(--brand-primary);
	}

	.reading-list p {
		margin-top: var(--space-8);
		font-size: var(--type-body);
		color: var(--text-secondary);
	}

	.account-details {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		align-items: flex-start;
	}

	.account-note {
		font-size: var(--type-body);
		color: var(--text-secondary);
	}

	.account-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-16);
		width: 100%;
		margin-top: var(--space-8);
	}

	.account-item {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-20);
		border: 1px solid var(--border-default);
		border-radius: var(--radius-module);
	}

	.account-item dt {
		font-size: var(--type-small);
		font-weight: 600;
		color: var(--text-secondary);
	}

	.account-item dd {
		font-size: var(--type-body);
		color: var(--text-primary);
		/* An address with no spaces in it should wrap rather than push out. */
		overflow-wrap: anywhere;
	}

	.preferences-status {
		padding: var(--space-12) var(--space-16);
		border-radius: var(--radius-control);
		background: var(--status-information-surface);
		font-size: var(--type-small);
		line-height: var(--ui-leading);
		color: var(--status-information);
	}

	.reading-help {
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	/* Tablet and mobile — the rail gives way to the responsive tab strip */
	@media (max-width: 1023px) {
		.workspace {
			flex-direction: column;
			gap: var(--space-28);
			padding-block: var(--space-40) var(--space-64);
		}

		.account-rail {
			display: none;
		}

		.account-main {
			flex: none;
			width: 100%;
		}

		.bottom {
			flex-direction: column;
		}

		.preferences,
		.reading {
			width: 100%;
			flex: none;
		}
	}

	@media (max-width: 767px) {
		/* Two columns cannot hold an email address at this width. */
		.account-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		h1 {
			font-size: 40px;
		}

		.lead {
			font-size: var(--type-body);
		}

		.upcoming {
			padding: var(--space-24);
		}

		.cancel {
			display: flex;
			align-items: center;
			min-height: 48px;
		}
	}
</style>
