---
/*
 * Site footer — Figma 5:21927 (desktop), 5:22121 (tablet), 5:22312 (mobile).
 *
 * The Figma file also draws a condensed footer on the inner screens
 * (5:22463), but the site uses this one everywhere so the footer reads the
 * same on every page.
 */
import { site } from '../data/site';

const { wordmark, footer } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="information">
		<div class="brand">
			<p class="wordmark">{wordmark}</p>
			<p class="tagline">{footer.tagline}</p>
			<p class="support">{footer.support}</p>
			<p class="email">{footer.email}</p>
		</div>

		<div class="directory">
			{
				footer.columns.map((group) => (
					<div class="group">
						<p class="group-title">{group.title}</p>
						<ul>
							{group.links.map((link) => (
								<li>
									<a class="link-underline" href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>

	<div class="footer-divider"></div>

	<div class="legal">
		<p class="notice">
			&copy; {year} {footer.legal}
		</p>
		<div class="policy">
			{footer.policyLinks.map((link) => <a class="link-underline" href={link.href}>{link.label}</a>)}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		display: flex;
		flex-direction: column;
		gap: var(--space-40);
		align-items: flex-start;
		padding: var(--space-56) var(--layout-pad) var(--space-32);
		background: var(--brand-primary);
		color: var(--text-inverse);
	}

	.wordmark {
		font-family: var(--font-editorial);
		font-size: 25px;
		line-height: normal;
		letter-spacing: -0.8px;
	}

	.footer-divider {
		width: 100%;
		height: 1px;
		background: var(--bg-surface);
	}

	.information {
		display: flex;
		gap: var(--space-48);
		align-items: flex-start;
		width: 100%;
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 18px;
		width: 380px;
		flex-shrink: 0;
	}

	.tagline {
		font-family: var(--font-editorial);
		font-size: var(--type-card-heading);
		line-height: var(--editorial-leading);
		letter-spacing: -0.8px;
	}

	.support {
		font-size: var(--type-body);
		color: var(--bg-sage-decorative);
	}

	.email {
		font-size: var(--type-small);
	}

	.directory {
		display: flex;
		flex: 1 0 0;
		flex-wrap: wrap;
		gap: var(--space-32);
		align-items: flex-start;
		min-width: 0;
	}

	.group {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: 14px;
		min-width: 140px;
	}

	.group-title {
		font-size: var(--type-small);
		font-weight: 600;
	}

	.group a {
		font-size: var(--type-small);
		line-height: 2.8;
	}

	.legal {
		display: flex;
		gap: var(--space-24);
		align-items: flex-start;
		width: 100%;
		font-size: var(--type-caption);
	}

	.notice {
		flex: 1 0 0;
		min-width: 0;
		color: var(--bg-sage-decorative);
	}

	.policy {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-24);
	}

	.policy a {
		white-space: nowrap;
	}

	/* Tablet — the brand column narrows and the directory wraps 2-up */
	@media (max-width: 1023px) {
		.brand {
			width: 240px;
		}

		.group {
			min-width: 180px;
		}
	}

	/* Mobile — brand above a two-column directory */
	@media (max-width: 767px) {
		.information {
			flex-direction: column;
			gap: var(--space-32);
		}

		.brand {
			width: 100%;
		}

		.group {
			flex: 0 0 calc(50% - var(--space-16));
			min-width: 140px;
		}

		.legal {
			flex-direction: column;
			gap: var(--space-24);
		}
	}
</style>
