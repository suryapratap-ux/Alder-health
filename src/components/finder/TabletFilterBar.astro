---
import Button from '../Button.astro';
import page from '../../content/pages/find-a-doctor.json';

/* Tablet filter bar — Figma 5:22501. Shown between 768px and 1023px. */
const { filters } = page;
const { specialties, clinics } = filters;
---

<div class="filter-bar">
	<div class="choices">
		<div class="field">
			<label class="field-label" for="bar-specialty">{filters.specialtyLabel}</label>
			<select class="control" id="bar-specialty" name="specialty" data-filter="specialty">
				{specialties.map((item) => <option>{item}</option>)}
			</select>
		</div>

		<div class="field">
			<label class="field-label" for="bar-location">{filters.locationLabel}</label>
			<select class="control" id="bar-location" name="location" data-filter="clinic">
				{clinics.map((item) => <option>{item}</option>)}
			</select>
		</div>
	</div>

	<div class="visit-types">
		<label class="check-option">
			<input type="checkbox" name="visit" value="in-person" data-filter="visit" />
			{filters.inPersonLabel}
		</label>
		<label class="check-option">
			<input type="checkbox" name="visit" value="video" data-filter="visit" />
			{filters.videoLabel}
		</label>
		<Button variant="secondary" class="more-filters" data-filter-toggle>{filters.moreLabel}</Button>
	</div>
</div>

<style>
	.filter-bar {
		display: none;
		flex-direction: column;
		gap: var(--space-16);
		align-items: flex-start;
		width: 100%;
	}

	.choices {
		display: flex;
		gap: var(--space-16);
		align-items: flex-start;
		width: 100%;
	}

	.visit-types {
		display: flex;
		gap: var(--space-24);
		align-items: flex-start;
		width: 100%;
	}

	.visit-types .check-option {
		flex: 1 0 0;
		min-width: 0;
	}

	@media (max-width: 1023px) {
		.filter-bar {
			display: flex;
		}
	}

	@media (max-width: 767px) {
		.filter-bar {
			display: none;
		}
	}
</style>
