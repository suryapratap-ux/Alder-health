---
import Button from '../Button.astro';
import page from '../../content/pages/find-a-doctor.json';

/* Compact filters — Figma 5:22615. Mobile only. */
const { filters } = page;
---

<div class="compact-filters">
	<Button variant="secondary" fullWidth class="filters-button" data-filter-toggle>
		<img src="/icons/sliders-horizontal.svg" width="18" height="18" alt="" />
		{filters.toggleLabel} &middot; <span data-filter-count>0</span> {filters.selectedLabel}
	</Button>
	<p class="summary" data-filter-summary>{filters.summaryDefault}</p>
</div>

<style>
	.compact-filters {
		display: none;
		flex-direction: column;
		gap: 14px;
		align-items: flex-start;
		width: 100%;
	}

	.summary {
		font-size: var(--type-caption);
		color: var(--text-secondary);
	}

	@media (max-width: 767px) {
		.compact-filters {
			display: flex;
		}
	}
</style>
