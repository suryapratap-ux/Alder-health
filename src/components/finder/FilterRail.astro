---
/*
 * Filtering rail — Figma 5:22370.
 *
 * On desktop it is a permanent sidebar. Below 1024px it collapses and is
 * opened by the tablet bar's "More filters" or the mobile "Filters" button,
 * so there is one set of controls to keep in step rather than three.
 */
import page from '../../content/pages/find-a-doctor.json';

const { filters } = page;
const { specialties, clinics, visitTypes, languages } = filters;
---

<aside class="rail" aria-label="Refine your search" data-filter-rail data-open="false">
	<div class="heading">
		<p class="title">{filters.railTitle}</p>
		<button class="reset" type="button" data-filter-reset>{filters.resetLabel}</button>
	</div>

	<div class="rule"></div>

	<div class="field">
		<label class="field-label" for="rail-specialty">{filters.specialtyLabel}</label>
		<select class="control" id="rail-specialty" name="specialty" data-filter="specialty">
			{specialties.map((item) => <option>{item}</option>)}
		</select>
	</div>

	<div class="field">
		<label class="field-label" for="rail-location">{filters.locationLabel}</label>
		<select class="control" id="rail-location" name="location" data-filter="clinic">
			{clinics.map((item) => <option>{item}</option>)}
		</select>
	</div>

	<div class="rule"></div>

	<div class="group">
		<p class="group-label" id="rail-visit-label">{filters.visitTypeLabel}</p>
		<div class="options" role="group" aria-labelledby="rail-visit-label">
			{
				visitTypes.map((option) => (
					<label class="check-option">
						<input type="checkbox" name="visit" value={option.id} data-filter="visit" />
						{option.label}
					</label>
				))
			}
		</div>
	</div>

	<div class="rule"></div>

	<div class="group">
		<p class="group-label" id="rail-language-label">{filters.languagesLabel}</p>
		<div class="options" role="group" aria-labelledby="rail-language-label">
			{
				languages.map((option) => (
					<label class="check-option">
						<input type="checkbox" name="language" value={option.id} data-filter="language" />
						{option.label}
					</label>
				))
			}
		</div>
	</div>

	<p class="note">{filters.note}</p>
</aside>

<style>
	.rail {
		display: flex;
		flex-direction: column;
		gap: var(--space-24);
		align-items: flex-start;
		width: 248px;
		flex-shrink: 0;
		padding-right: var(--space-24);
	}

	.heading {
		display: flex;
		gap: var(--space-12);
		align-items: flex-start;
		justify-content: space-between;
		width: 100%;
	}

	.title {
		flex: 1 0 0;
		min-width: 0;
		font-size: var(--type-body);
		font-weight: 600;
		color: var(--text-primary);
	}

	.reset {
		padding: 0;
		border: 0;
		background: none;
		font-family: var(--font-ui);
		font-size: var(--type-caption);
		color: var(--text-secondary);
		white-space: nowrap;
		cursor: pointer;
	}

	.reset:hover {
		color: var(--brand-primary);
	}

	/*
	 * The rail spaces its sections 24px apart, which pushed every checkbox the
	 * same distance from its neighbour. The rows belong together, so each group
	 * holds its own list and only the groups keep the rail's rhythm.
	 */
	.group {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		width: 100%;
	}

	.options {
		display: flex;
		flex-direction: column;
	}

	.group-label {
		font-size: var(--type-small);
		font-weight: 600;
		color: var(--text-secondary);
	}

	.note {
		font-size: var(--type-caption);
		color: var(--text-secondary);
	}

	.field {
		width: 100%;
		flex: none;
	}

	/* Tablet and mobile — a panel the filter buttons disclose */
	@media (max-width: 1023px) {
		.rail {
			display: none;
			width: 100%;
			padding: var(--space-20);
			padding-right: var(--space-20);
			border: 1px solid var(--border-default);
			border-radius: var(--radius-module);
			background: var(--bg-surface);
		}

		.rail[data-open='true'] {
			display: flex;
		}
	}
</style>
