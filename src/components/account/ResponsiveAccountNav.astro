---
/*
 * Responsive account navigation — Figma 5:23905 (tablet) / 5:24004 (mobile).
 * Replaces the desktop account rail below 1024px: a caption line above a row
 * of tabs on a hairline rule.
 *
 * It takes the same items as the rail rather than keeping its own copy, so
 * the two cannot disagree about where a link goes.
 */
interface Item {
	label: string;
	href: string;
}

interface Props {
	items: Item[];
	caption: string;
}

const { items, caption } = Astro.props;
---

<nav class="account-tabs-nav" aria-label="Patient account">
	<p class="caption">{caption}</p>

	<div class="tabs">
		{
			items.map((item, index) => (
				<a
					href={item.href}
					class:list={['tab', 'link-underline', index === 0 && 'tab--current']}
					data-section={item.href.startsWith('#') ? item.href.slice(1) : undefined}
				>
					{item.label}
				</a>
			))
		}
	</div>
</nav>

<style>
	.account-tabs-nav {
		display: none;
		flex-direction: column;
		gap: var(--space-16);
		align-items: flex-start;
		width: 100%;
		/*
		 * A flex item will not shrink below its content by default, which
		 * would let the tab row push the page sideways instead of scrolling.
		 */
		min-width: 0;
	}

	.caption {
		font-size: var(--type-caption);
		line-height: var(--ui-leading);
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	/*
	 * Six destinations will not fit across a phone, so the strip scrolls
	 * sideways rather than wrapping into a block of links.
	 */
	.tabs {
		display: flex;
		gap: var(--space-16);
		align-items: flex-start;
		width: 100%;
		padding-bottom: var(--space-12);
		border-bottom: 1px solid var(--border-default);
		overflow-x: auto;
		scrollbar-width: thin;
	}

	.tab {
		font-size: var(--type-small);
		line-height: var(--ui-leading);
		color: var(--brand-primary);
		white-space: nowrap;
	}

	.tab--current {
		font-weight: 600;
	}

	@media (max-width: 1023px) {
		.account-tabs-nav {
			display: flex;
		}
	}
</style>
