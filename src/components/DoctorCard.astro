---
import Button from './Button.astro';
import type { Clinician } from '../data/clinicians';

/* Doctor card — Figma 5:22414 / 5:22509 / 5:22620. */
interface Props {
	clinician: Clinician;
}

const { clinician } = Astro.props;
---

<article class="doctor-card">
	<div class="overview">
		<img
			class="portrait"
			src={clinician.photo}
			width={clinician.photoWidth}
			height={clinician.photoHeight}
			style={`object-position: ${clinician.photoFocus}`}
			alt={clinician.alt}
		/>

		<div class="profile">
			<h3 class="name">{clinician.name}</h3>

			<div class="facts">
				<p class="specialty">{clinician.specialty}</p>
				<p>{clinician.languages}</p>
				<p>{clinician.clinic}</p>
				<p>{clinician.formats}</p>
			</div>

			<div class="divider"></div>

			<p class="availability">Next example visit &middot; {clinician.nextVisit}</p>

			<div class="actions">
				<Button href={`/doctors/${clinician.slug}`} variant="secondary">View profile</Button>
				<Button href={`/booking?doctor=${clinician.slug}`}>Book a visit</Button>
			</div>

			<p class="disclaimer">Illustrative portrait &middot; profile and credentials are fictional.</p>
		</div>
	</div>
</article>

<style>
	.doctor-card {
		border: 1px solid var(--border-default);
		border-radius: var(--radius-module);
		background: var(--bg-surface);
		overflow: hidden;
	}

	.overview {
		display: flex;
		gap: var(--space-24);
		align-items: flex-start;
		padding: var(--space-24);
	}

	.portrait {
		width: 144px;
		height: 168px;
		flex-shrink: 0;
		object-fit: cover;
	}

	.profile {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-12);
		min-width: 0;
	}

	.name {
		font-size: var(--type-card-heading);
	}

	.facts p {
		font-size: var(--type-small);
		line-height: 1.8;
		color: var(--text-secondary);
	}

	.facts .specialty {
		font-weight: 600;
		color: var(--brand-primary);
	}

	.divider {
		height: 1px;
		background: var(--border-default);
	}

	.availability {
		font-size: var(--type-small);
		color: var(--status-success);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-12);
	}

	.disclaimer {
		font-size: var(--type-eyebrow);
		color: var(--text-muted);
	}

	/* Mobile — the portrait sits above the profile */
	@media (max-width: 767px) {
		.overview {
			flex-direction: column;
		}

		.portrait {
			width: 100%;
			height: 220px;
		}

		.profile {
			flex: none;
			width: 100%;
		}
	}
</style>
