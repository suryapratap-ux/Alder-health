---
import Button from '../Button.astro';

import { home } from '../../data/pages';

/* Humane editorial hero — Figma 5:21771 / 5:21965 / 5:22156. */
const { hero } = home;
---

<section class="hero">
	<div class="promise">
		<p class="eyebrow">{hero.eyebrow}</p>
		<h1>{hero.heading}</h1>
		<p class="lead">{hero.lead}</p>

		<div class="actions">
			<Button href={hero.primaryCta.href}>
				<img src="/icons/arrow-right.svg" width="18" height="18" alt="" />
				{hero.primaryCta.label}
			</Button>
			<Button href={hero.secondaryCta.href} variant="secondary">{hero.secondaryCta.label}</Button>
		</div>

		<p class="formats">
			<img src="/icons/map-pin.svg" width="17" height="17" alt="" />
			{hero.formats}
		</p>
	</div>

	<figure class="media">
		<img
			class="photograph"
			src={hero.image.src}
			width="1376"
			height="768"
			style={`object-position: ${hero.image.focus}`}
			alt={hero.image.alt}
		/>
		<figcaption>{hero.caption}</figcaption>
	</figure>
</section>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: var(--space-56);
		padding: var(--space-64) var(--layout-gutter);
	}

	.promise {
		display: flex;
		flex-direction: column;
		gap: var(--space-24);
		align-items: flex-start;
		width: 550px;
		flex-shrink: 0;
	}

	h1 {
		font-size: var(--type-hero);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-12);
	}

	.formats {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: var(--type-small);
		color: var(--text-secondary);
	}

	.media {
		display: flex;
		flex: 1 0 0;
		flex-direction: column;
		gap: var(--space-12);
		min-width: 0;
		margin: 0;
	}

	.photograph {
		width: 100%;
		height: 520px;
		border-radius: var(--radius-control);
		object-fit: cover;
	}

	figcaption {
		font-size: var(--type-eyebrow);
		line-height: var(--ui-leading);
		color: var(--text-secondary);
	}

	/* Tablet — the photograph moves below the promise */
	@media (max-width: 1023px) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-32);
			padding: var(--space-40) var(--layout-gutter) var(--space-32);
		}

		.promise {
			width: 100%;
		}

		.media {
			width: 100%;
			flex: none;
		}

		.photograph {
			height: 410px;
		}
	}

	@media (max-width: 767px) {
		.photograph {
			height: 300px;
		}
	}
</style>
