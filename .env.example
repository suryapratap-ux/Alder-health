# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# The first value you set yourself. The other four are generated for you by the
# wizard at /keystatic/setup, which creates a GitHub App on your account; it
# prints them ready to paste. See the README.

# The repository the CMS reads and writes, as "owner/repository".
PUBLIC_KEYSTATIC_GITHUB_REPO=

# From /keystatic/setup.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
