# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# The Keystatic Cloud project that holds this site's content, as
# "team/project". Find it on the project's settings page at
# https://keystatic.cloud. Cloud handles sign-in, so there is no GitHub App to
# create and no client secret to manage.

PUBLIC_KEYSTATIC_CLOUD_PROJECT=
